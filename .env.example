# Credentials are injected at runtime. Never commit real values.

# Database
DATABASE_URL=

# App
APP_BASE_URL=
API_BASE_URL=
AUTH_SECRET=
FORGE_ENV=development
FORGE_AUTO_MIGRATE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
PROVIDER_HTTP_TIMEOUT_SECONDS=30

# Auth providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=FORGE <login@example.com>

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=forge-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com

# RunPod
RUNPOD_API_KEY=
RUNPOD_RECONSTRUCTION_ENDPOINT_ID=
RUNPOD_PACKAGE_ENDPOINT_ID=
RUNPOD_RETARGET_ENDPOINT_ID=
FORGE_GPU_IMAGE=ghcr.io/joonghui0926/forge-worker@sha256:<digest>
FORGE_PIPELINE_VERSION=forge-compiler-v1
FORGE_DATASET_VERSION=v1
FORGE_CALLBACK_TOKEN=

# Terac — physical data acquisition
TERAC_WEBHOOK_SECRET=
TERAC_MCP_BRIDGE_URL=
TERAC_MCP_BRIDGE_TOKEN=

# Band — operating decisions
BAND_API_KEY=
BAND_API_BASE_URL=https://app.band.ai/api/v1
BAND_ROOM_ID=
BAND_COLLECTION_AGENT_ID=
BAND_COLLECTION_AGENT_NAME=Collection Architect
BAND_COLLECTION_AGENT_HANDLE=
BAND_QUALITY_AGENT_ID=
BAND_QUALITY_AGENT_NAME=Quality Council
BAND_QUALITY_AGENT_HANDLE=
BAND_DECISION_WEBHOOK_SECRET=

# Pioneer — learned quality
PIONEER_API_KEY=
PIONEER_API_BASE_URL=https://api.pioneer.ai/v1
PIONEER_MODEL_ID=Qwen/Qwen3-8B
PIONEER_THRESHOLD_VERSION=forge-quality-thresholds-v1

# Render — durable control plane
RENDER_API_KEY=
RENDER_API_BASE_URL=https://api.render.com/v1
RENDER_HTTP_TIMEOUT_SECONDS=30
RENDER_WORKFLOW_SLUG=forge-control-plane

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PAYMENT_LINK_URL=
STRIPE_PAYMENT_LINK_ID=
STRIPE_EXPECTED_AMOUNT_CENTS=35000
STRIPE_EXPECTED_CURRENCY=usd
STRIPE_WEBHOOK_SECRET=

# External model assets (local/test only — never commit or include in images)
MANO_MODEL_DIR=C:/absolute/path/to/mano_v1_2/models

# ML tokens
HF_TOKEN=
GITHUB_TOKEN=

# Observability
SENTRY_DSN=
