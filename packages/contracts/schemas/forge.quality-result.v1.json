{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge.quality-result.v1",
  "title": "FORGE Quality Result",
  "type": "object",
  "required": ["schema_version", "qc_run_id", "subject_id", "subject_type", "stage", "order_id", "passed", "reason_codes", "metrics", "config_hash", "provenance_parent_ids"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "forge.quality-result.v1" },
    "qc_run_id": { "type": "string", "pattern": "^qc_" },
    "subject_id": { "type": "string" },
    "subject_type": { "type": "string", "enum": ["capture", "reconstruction", "skill_ir", "robot_trajectory", "episode"] },
    "stage": { "type": "string", "enum": ["pre_qc", "reconstruction", "contact", "retarget", "source_validation", "batch_qc"] },
    "order_id": { "type": "string", "pattern": "^ord_" },
    "passed": { "type": "boolean" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "thresholds_applied": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "evidence_uris": { "type": "array", "items": { "type": "string", "pattern": "^r2://" } },
    "config_hash": { "type": "string" },
    "simulation": { "type": "boolean", "default": false },
    "provenance_parent_ids": { "type": "array", "items": { "type": "string" } }
  }
}
