{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge.gpu-job.v1",
  "title": "FORGE GPU Job Request",
  "type": "object",
  "required": ["schema_version", "job_id", "idempotency_key", "stage", "input_artifacts", "config_uri", "container", "output_prefix", "callback_token_ref", "attempt"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "forge.gpu-job.v1" },
    "job_id": { "type": "string", "pattern": "^job_" },
    "idempotency_key": { "type": "string" },
    "stage": {
      "type": "string",
      "enum": ["reconstruction", "contact", "retarget_fast", "retarget_heavy", "validate", "package"]
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri", "sha256"],
        "additionalProperties": false,
        "properties": {
          "uri": { "type": "string", "pattern": "^r2://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "config_uri": { "type": "string", "pattern": "^r2://" },
    "container": {
      "type": "object",
      "required": ["image", "pipeline_version"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string" },
        "pipeline_version": { "type": "string" }
      }
    },
    "output_prefix": { "type": "string", "pattern": "^r2://" },
    "callback_token_ref": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 }
  }
}
